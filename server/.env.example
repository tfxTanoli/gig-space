PORT=3001
FRONTEND_URL=http://localhost:5173

# Firebase — copy from your Firebase project settings
FIREBASE_DATABASE_URL=https://gigspace-208b4-default-rtdb.firebaseio.com

# Storage bucket the backend writes generated-listing photos into. Optional —
# defaults to "<service-account project_id>.firebasestorage.app". Set it only if
# your bucket doesn't follow that naming (e.g. older ".appspot.com" buckets).
# FIREBASE_STORAGE_BUCKET=gigspace-208b4.firebasestorage.app

# Firebase service account key JSON file path
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Stripe — from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Optional: pre-create the $5/month extra-location price in your Stripe dashboard
# and paste its price ID here to skip the auto-create-and-cache flow.
# If omitted, the server creates the price once and caches it in Firebase at
# settings/stripe/extraLocationPriceId.
# STRIPE_EXTRA_LOCATION_PRICE_ID=price_XXXXXXXXXXXXXXXXXXXX

# Google Places API (New) — powers the admin "Listings" generator (search public
# businesses by keyword + city and auto-create marketplace posts).
# Enable "Places API (New)" in Google Cloud Console and create an API key.
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Optional: rewrite generated listing titles into marketplace headlines with AI.
# Without a key, generation still works — posts keep the composed title
# ("<Business> — <service> in <city>"), which is already better than a raw
# website <title> like "Home". One batched request per generate, so cost scales
# with batches rather than posts.
#
# Gemini is used when both are set: it's the cheaper of the two and this stack
# already runs on Google Cloud. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional override — defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Alternative provider, used only when GEMINI_API_KEY is absent.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
