# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
# Server tsc build output
server/lib

# Environment variables
.env
.env.local
.env.*.local
server/.env
# Bare env files (no dot) used locally — contain live secrets, never commit
/env
/server/env

# Firebase / Google service account keys — NEVER commit these
*-firebase-adminsdk-*.json
serviceAccountKey.json
server/serviceAccountKey.json

# Claude Code — local overrides and MCP config contain secrets, never commit
.claude/settings.local.json
.mcp.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# Local QA artifacts at the repo root — Playwright/Linear/Stripe page dumps and
# screenshots. These are throwaway, and a Linear dump has already been found
# holding a live Stripe secret key, so they must never be committable.
# Root-anchored so tracked images under public/ and dist/ are unaffected.
/*.yml
/*.yaml
/*.png
/*.jpg
# Playwright/Linear dumps also land here as markdown (e.g. accessibility-tree
# snapshots) — same risk as above. README.md/PROJECT_SUMMARY.md stay tracked;
# root-anchoring plus the pre-existing gitignore only blocks NEW untracked
# root .md files, it can't untrack files already in git.
/*.md
# Agent/tool working directories — page snapshots here have held API keys.
.playwright-mcp/
.codex/
