{
  "trailingSlash": false,
  "functions": {
    "api/page.ts": { "includeFiles": "dist/app.html" },
    "api/post-page.ts": { "includeFiles": "dist/app.html" }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.gigspace.co" }],
      "destination": "https://gigspace.co/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "gig-space.vercel.app" }],
      "destination": "https://gigspace.co/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "gig-space-lac.vercel.app" }],
      "destination": "https://gigspace.co/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-:name.xml", "destination": "/api/sitemap?name=:name" },
    { "source": "/posts/:business/:slug", "destination": "/api/post-page?business=:business&slug=:slug" },
    { "source": "/posts/(.*)", "destination": "/api/post-page?notfound=1" },
    { "source": "/service-detail", "destination": "/api/post-page" },
    { "source": "/share", "destination": "/api/og" },
    { "source": "/", "destination": "/api/page?ssr_route=home" },
    { "source": "/search", "destination": "/api/page?ssr_route=search" },
    { "source": "/for-sellers", "destination": "/api/page?ssr_route=for-sellers" },
    { "source": "/about", "destination": "/api/page?ssr_route=about" },
    { "source": "/affiliate", "destination": "/api/page?ssr_route=affiliate" },
    { "source": "/terms", "destination": "/api/page?ssr_route=terms" },
    { "source": "/privacy", "destination": "/api/page?ssr_route=privacy" },
    { "source": "/(.*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
