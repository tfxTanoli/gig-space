{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-:name.xml", "destination": "/api/sitemap?name=:name" },
    { "source": "/posts/:business/:slug", "destination": "/api/post-page?business=:business&slug=:slug" },
    { "source": "/service-detail", "destination": "/api/post-page" },
    { "source": "/share", "destination": "/api/og" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
